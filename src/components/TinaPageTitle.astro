---
import { requestWithMetadata } from '@tinacms/astro/data';
import { tinaField } from '@tinacms/astro/tina-field';
import { isEditMode } from '@tinacms/astro/is-edit-mode';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { serverClient, serverFetchOptions } from '../lib/tina/server-client';
import ThemePageTitle from '@six-tech/starlight-theme-six/overrides/PageTitle.astro';
import DocsTitle from './tina/DocsTitle.astro';
import { islands } from '../lib/tina/islands';

const pathname = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const relativePath = pathname ? `${pathname}.mdx` : '';
const slug = pathname;
let document = null;

if (relativePath && isEditMode(Astro.request)) {
  try {
    const result = await requestWithMetadata(
      serverClient.queries.docs({ relativePath }, { fetchOptions: serverFetchOptions(Astro.request) }),
      { priority: 'primary' },
    );
    document = result.data?.docs;
  } catch {
    // Pages outside the Tina docs collection keep the normal Starlight title.
  }
}
---

{document && isEditMode(Astro.request) ? (
  <TinaIsland name="docsTitle" wrapper={islands.docsTitle.wrapper} params={{ slug }}>
    <DocsTitle data={document} />
  </TinaIsland>
) : (
  <div data-tina-field={document ? tinaField(document, 'title') : undefined}>
    <ThemePageTitle />
  </div>
)}
