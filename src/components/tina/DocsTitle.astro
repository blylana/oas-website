---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  data?: {
    title?: string | null;
    description?: string | null;
  } | null;
}

const { data } = Astro.props;
---

{data && (
  <>
    <div class="tina-doc-breadcrumb" aria-hidden="true">
      <span>Docs</span>
      <span class="tina-doc-breadcrumb-separator">›</span>
      <span>{data.title}</span>
    </div>
    <h1 id="_top" data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
    {data.description && (
      <p data-tina-field={tinaField(data, 'description')}>{data.description}</p>
    )}
  </>
)}

<style>
  .tina-doc-breadcrumb {
    color: var(--muted-foreground);
    line-height: 1;
    font-size: 0.875rem;
    align-items: center;
    display: flex;
    margin-bottom: 1rem;
  }

  .tina-doc-breadcrumb-separator {
    margin: 0 0.5rem;
    font-size: 1.25rem;
  }

  h1 {
    color: var(--foreground-light);
    letter-spacing: -0.025em;
    font-weight: 800;
    font-size: 2.875rem;
    line-height: 3rem;
    scroll-margin: 5rem;
    margin: 0;
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.5rem;
    text-wrap: balance;
  }
</style>
