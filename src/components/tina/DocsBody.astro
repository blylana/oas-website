---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import ThemeMarkdownContent from '@six-tech/starlight-theme-six/overrides/MarkdownContent.astro';

interface Props {
  data?: {
    body?: unknown;
  } | null;
}

const { data } = Astro.props;
---

<ThemeMarkdownContent>
  {data?.body && (
    <div data-tina-field={tinaField(data, 'body')}>
      <TinaMarkdown content={data.body} />
    </div>
  )}
</ThemeMarkdownContent>
