# Compose interpolation variables
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace-with-a-long-alphanumeric-password

# The backend container reaches MongoDB by the Compose service name.
# URL-encode credentials if they contain URI-reserved characters.
MONGODB_URI=mongodb://root:replace-with-a-long-alphanumeric-password@mongo:27017/tinacms?authSource=admin

TINA_PUBLIC_IS_LOCAL=false
PORT=4322
LOG_LEVEL=info

GITHUB_OWNER=nearaura
GITHUB_REPO=oas-website
GITHUB_BRANCH=tina

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
TINA_PUBLIC_ALLOWED_EMAIL=replace-with-editor-email
# Optional Clerk organization restriction.
# TINA_PUBLIC_CLERK_ORG_ID=org_...
